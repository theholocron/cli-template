{
  "name": "@theholocron/cli-template",
  "version": "1.1.0",
  "description": "A modern CLI template with pre-configured tools, best practices, and CI/CD setup for rapid project development.",
  "homepage": "https://docs.theholocron.dev/cli-template/",
  "bugs": "https://github.com/theholocron/cli-template/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/cli-template.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "main": "./dist/cli.mjs",
  "bin": {
    "cli-template": "./dist/cli.mjs"
  },
  "man": "./man/cli-template.1",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "mkdir -p man && marked-man README.md > man/cli-template.1",
    "lint": "docker run -rm -e RUN_LOCAL=true -v .:/tmp/lint github/super-linter",
    "prepare": "husky",
    "release": "semantic-release",
    "dev": "tsx ./src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@theholocron/env-utils": "^1.2.1",
    "chalk": "^5.6.2",
    "conf": "^13.1.0",
    "default-browser": "^5.5.0",
    "dotenv": "^17.4.2",
    "inquirer-autocomplete-standalone": "^0.8.1",
    "open": "^10.2.0",
    "open-editor": "^4.1.1",
    "ora": "^8.2.0",
    "play-sound": "^1.1.6",
    "update-notifier": "^7.3.1",
    "winston": "^3.19.0",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@theholocron/cli": "^3.14.0",
    "@theholocron/commitlint-config": "^7.14.4",
    "@theholocron/eslint-config": "^7.14.4",
    "@theholocron/holocron-config": "^7.14.4",
    "@theholocron/holocron-plugin-github": "^3.13.0",
    "@theholocron/lint-staged-config": "^7.14.4",
    "@theholocron/prettier-config": "^7.14.4",
    "@theholocron/semantic-release-config": "^7.14.4",
    "@theholocron/skills": "^1.3.2",
    "@theholocron/tsconfig": "^7.14.4",
    "@theholocron/tsdown-config": "^7.15.0",
    "@theholocron/vitest-config": "^7.14.4",
    "@types/play-sound": "^1.1.2",
    "@types/update-notifier": "^6.0.8",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "alex": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "marked-man": "^2.1.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "conventional-changelog-conventionalcommits": "9.3.1"
    }
  },
  "releases": "https://github.com/theholocron/cli-template/releases",
  "wiki": "https://github.com/theholocron/cli-template/wiki"
}
