# Copy this file to .env and fill in your values.
#
# The CLI_TEMPLATE prefix is this project's namespace.
# When using this template, replace CLI_TEMPLATE with your own
# namespace throughout (e.g. HOLOCRON, RANDO) so that each CLI
# has its own isolated env vars and multiple CLIs can coexist.
CLI_TEMPLATE_DEBUG=false
CLI_TEMPLATE_SOUND=false
CLI_TEMPLATE_VERBOSE=false
