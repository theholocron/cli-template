{
  "display": "CLI Template",
  "extends": "@theholocron/tsconfig/node-lts",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      "@/media": ["./media/*"],
      "@/package": ["./package.json"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["./node_modules"]
}
